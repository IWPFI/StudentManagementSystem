<Window x:Class="StudentManagementSystem.View.SearchStudentWindow" Name="window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:StudentManagementSystem.View"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="SearchView"
        Width="700"
        Height="500"
        AllowsTransparency="True"
        Background="{x:Null}"
        FontWeight="ExtraLight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
    <Border MouseLeftButtonDown="MouseLeftButtonDown" Style="{DynamicResource SearchStudentWindow_BorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="80" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource TitleTestBlockStyle}" />

            <TextBox Name="studentTextBox"
                     x:FieldModifier="public"
                     Style="{DynamicResource SearchStudentWindow_ContentTextBoxStyle}"
                     Text="" />

            <Button Name="seekButton"
                    Command="{Binding SeekCommand}"
                    CommandParameter="{Binding ElementName=studentTextBox, Path=Text}"
                    Style="{DynamicResource SeekButtonStyle}" />

            <Button Name="closeButton"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding ElementName=window}"
                    Style="{StaticResource SearchStudentWindow_CloceButtonStyle}" />

            <Border Grid.Row="2" Background="White" CornerRadius="0 0 5 5">
                <DataGrid Grid.Row="2"
                          Margin="10,5"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding StudentList, UpdateSourceTrigger=PropertyChanged}"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="25" Binding="{Binding Id}" Header="序号" />
                        <DataGridTextColumn Width="*" Binding="{Binding StudentID}" Header="学号" />
                        <DataGridTextColumn Width="*" Binding="{Binding StudentName}" Header="姓名" />
                        <DataGridTextColumn Width="*" Binding="{Binding StudentGrade}" Header="班级" />
                        <DataGridTextColumn Width="*" Binding="{Binding StudentPhone}" Header="电话" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>
