<UserControl x:Class="StudentManagementSystem.View.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StudentManagementSystem.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:StudentManagementSystem.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodel:SearchStudentViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Border Style="{DynamicResource WinBorderEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="9*" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Margin="110,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Text="学号" />
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Text="姓名" />
                <TextBlock Margin="0,0,110,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Text="序号" />
                <Border Margin="50,0"
                        VerticalAlignment="Bottom"
                        BorderBrush="Gray"
                        BorderThickness="0,0,0,2" />
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding StudentList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="20" Style="{DynamicResource BorderStyle}">
                                    <Grid>
                                        <TextBlock Margin="100,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   Foreground="#FF666161">
                                            <Hyperlink Command="{Binding DataContext.OpenStudentId, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" CommandParameter="{Binding StudentID}">
                                                <TextBlock Text="{Binding StudentID}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Margin="0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   Foreground="#FF666161"
                                                   Text="{Binding StudentName}" />
                                        <TextBlock Margin="100,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="20"
                                                   Foreground="#FF666161"
                                                   Text="{Binding Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  刷新  -->
                <Button Click="FlushStudentButtonClick" Style="{StaticResource ContactsFlushbutton}" />
                <!--  搜索  -->
                <Button Click="SearchStudentButtonClick" Style="{StaticResource ContactsSearchbutton}" />
                <!--  添加  -->
                <Button Click="AddStudentButtonClick" Style="{StaticResource ContactsAddbutton}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
